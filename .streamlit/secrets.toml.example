# Copie este arquivo para secrets.toml e preencha localmente.
# Nunca versione secrets.toml nem envie a chave ao chat.
GOOGLE_PLACES_API_KEY = "COLE_SUA_CHAVE_AQUI"

# Login do CRM: um usuario por linha, com hash bcrypt da senha (nunca a senha em texto puro).
# Gere um hash novo com: python scripts/gerar_hash_senha.py
[AUTH_USERS]
admin = "COLE_O_HASH_BCRYPT_AQUI"
